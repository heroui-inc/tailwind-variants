{
  "name": "tailwind-variants",
  "version": "3.3.1",
  "description": "🦄 Tailwindcss first-class variant API",
  "keywords": [
    "tailwindcss",
    "classes",
    "responsive",
    "variants",
    "styled",
    "styles"
  ],
  "author": "Junior Garcia <jrgarciadev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroui-inc/tailwind-variants"
  },
  "bugs": {
    "url": "https://github.com/heroui-inc/tailwind-variants/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.ts",
        "default": "./dist/lite.js"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --config .config/tsup.config.ts --watch",
    "build": "tsup --config .config/tsup.config.ts",
    "typecheck": "tsc --noEmit && pnpm typecheck:types",
    "typecheck:types": "tsc -p .config/tsconfig.type-tests.json",
    "benchmark": "pnpm build && node benchmark/run.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path .",
    "release": "bumpp --execute='pnpm run changelog' --all",
    "prepublishOnly": "pnpm run build",
    "release:check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "clean": "pnpm clean:cache && pnpm i",
    "clean:cache": "find . \\( -name 'dist' -o -name 'node_modules' -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.5",
    "bumpp": "12.3.0",
    "changelogithub": "15.0.5",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-angular": "9.4.0",
    "esbuild": "0.28.2",
    "tailwind-merge": "3.7.0",
    "tinybench": "6.2.2",
    "tsup": "9.0.0",
    "typescript": "5.6.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "tailwind-merge": ">=3.0.0",
    "tailwindcss": "*"
  },
  "peerDependenciesMeta": {
    "tailwind-merge": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "pnpm": ">=7.x",
    "node": ">=16.9.x"
  },
  "packageManager": "pnpm@12.14.0"
}
